---
import Marketing from '../layouts/Marketing.astro';
import Icon from '../components/Icon.astro';
import release from '../data/release.json';
const asset = (name: string) => release.assets.find(a => a.name === name)!;
const suffix = release.version;
const groups = [
 { title: 'Server deployment', icon: 'server', platform: 'Linux x64 / arm64 · Docker Compose', description: 'Deployment files for Web, API, optional PostgreSQL and HTTP MCP.', downloads: [{ name: `rateldesk-deployment-${suffix}.tar.gz`, label: 'Deployment bundle' }], guide: '/docs/getting-started/quickstart/' },
 { title: 'RatelDesk CLI', icon: 'terminal', platform: 'Linux glibc x64 / arm64 · Windows x64', description: 'Self-contained command-line tools for profiles, connection checks and helpdesk operations.', downloads: [{name:`rateldesk-cli-${suffix}-linux-x64.tar.gz`,label:'Linux x64'},{name:`rateldesk-cli-${suffix}-linux-arm64.tar.gz`,label:'Linux arm64'},{name:`rateldesk-cli-${suffix}-win-x64.zip`,label:'Windows x64'}], guide: '/docs/reference/cli/' },
 { title: 'MCP stdio server', icon: 'spark', platform: 'Linux glibc x64 / arm64 · Windows x64', description: 'Self-contained local MCP server for connecting a compatible assistant to the RatelDesk API.', downloads: [{name:`rateldesk-mcp-stdio-${suffix}-linux-x64.tar.gz`,label:'Linux x64'},{name:`rateldesk-mcp-stdio-${suffix}-linux-arm64.tar.gz`,label:'Linux arm64'},{name:`rateldesk-mcp-stdio-${suffix}-win-x64.zip`,label:'Windows x64'}], guide: '/docs/integrations/stdio/' },
];
---
<Marketing title={`RatelDesk releases & downloads — v${release.version}`} description="Download RatelDesk deployment files, CLI and MCP stdio packages. Find the documented preview and the latest stable release.">
 <section class="release-hero container"><p class="eyebrow">Releases & downloads</p><div class="release-title"><h1>Your helpdesk.<br/><span>Your infrastructure.</span></h1><div class="release-meta"><b>v{release.version}</b><span>Current preview · Documented here</span><time datetime="2026-10-30">30 October 2026</time></div></div><p>These guides target RatelDesk v{release.version}. Get the matching deployment files and operator tools, or open the latest stable release.</p><div class="hero-ctas"><a class="button" href={asset(`rateldesk-deployment-${suffix}.tar.gz`).url}><Icon name="download" size={17}/>Download preview bundle</a><a class="button button-secondary" href={release.stable.url}>Stable v{release.stable.version} <Icon name="arrowUp" size={16}/></a></div><p class="release-context">The stable release has its own assets and release notes. Setup examples on this site describe the current preview.</p></section>
 <section class="container release-highlights"><div><p class="eyebrow">Explore the platform</p><h2>A connected<br/>service workspace.</h2></div><ul><li><strong>Incidents and service requests</strong><span>Keep ownership, conversation and execution visible.</span></li><li><strong>Connected email</strong><span>Microsoft 365, IMAP/POP3, routing and outbound delivery.</span></li><li><strong>Self-service automation</strong><span>Request forms connected to configured NetRatel jobs.</span></li><li><strong>AI and assistant tools</strong><span>Native Netclaw ticket chat, HTTP MCP, stdio and CLI access.</span></li></ul></section>
 <section class="section container"><div class="section-head"><div><p class="eyebrow">Choose your download</p><h2>The right tools for your setup.</h2></div><a class="text-link" href="/docs/getting-started/requirements/">Requirements <Icon name="arrow" size={14}/></a></div><div class="download-grid">{groups.map(group => <article class="download-card"><Icon name={group.icon} size={24}/><p class="download-platform">{group.platform}</p><h3>{group.title}</h3><p>{group.description}</p><div class="download-actions">{group.downloads.map(file => <a href={asset(file.name).url} class="text-link"><Icon name="download" size={14}/>{file.label}<span class="file-size">{(asset(file.name).bytes/1024/1024).toFixed(1)} MiB</span></a>)}</div><a class="download-guide" href={group.guide}>Setup instructions <Icon name="arrow" size={12}/></a></article>)}</div></section>
 <section class="container release-integrity"><div><Icon name="shield" size={24}/><h2>Verify what you install.</h2><p>Check downloaded archives against SHA256SUMS. The release manifest records the source revision and published container images.</p></div><div class="integrity-links"><a href={asset('SHA256SUMS').url}>Archive checksums <Icon name="arrowUp" size={14}/></a><a href={asset('release-manifest.json').url}>Release manifest <Icon name="arrowUp" size={14}/></a><a href={asset('release-manifest.json.sha256').url}>Manifest checksum <Icon name="arrowUp" size={14}/></a><a href={release.url}>All {release.assets.length} release assets <Icon name="arrowUp" size={14}/></a></div></section>
 <section class="section container release-next"><div><h2>Already running RatelDesk?</h2><p>Review your configuration, persistent data and matching image versions before upgrading.</p><a class="button button-secondary" href="/docs/deployment/upgrades/">Upgrade your installation <Icon name="arrow" size={15}/></a></div><div><a class="text-link" href={release.url}>Current preview release notes <Icon name="arrowUp" size={14}/></a><a class="text-link" href="https://github.com/BostonTechnologies/rateldesk/releases">Release history <Icon name="arrowUp" size={14}/></a></div></section>
</Marketing>
<style>
  .release-hero { padding-block: 70px 65px; }
  .release-title { display: flex; justify-content: space-between; align-items: center; gap: 35px; }
  .release-title > * { min-width: 0; }
  .release-title h1 { font: 500 clamp(42px,5.2vw,67px)/1.1 var(--display); letter-spacing: -.055em; margin: 0 0 28px; }
  .release-title h1 span { color: var(--cyan); }
  .release-meta { text-align: right; }
  .release-meta b { display: block; font: 500 clamp(24px,3vw,35px) var(--display); letter-spacing: -.045em; color: var(--cyan); }
  .release-meta span, .release-meta time { display: block; color: #c4d5e7; font-size: 1rem; line-height: 1.5; margin-top: 12px; }
  .release-meta time { font: .875rem/1.6 var(--mono); color: var(--dim); }
  .release-hero > p:not(.eyebrow) { max-width: 640px; color: var(--muted); font-size: 1.125rem; line-height: 1.75; margin: 0 0 25px; }
  .release-hero > p.release-context { font-size: 1rem; line-height: 1.7; margin: 20px 0 0; color: var(--muted); }
  .release-highlights { display: grid; grid-template-columns: minmax(0,.8fr) minmax(0,1.2fr); gap: 48px; border-block: 1px solid var(--line); padding-block: 48px; }
  .release-highlights h2 { font: 500 29px/1.2 var(--display); letter-spacing: -.04em; margin: 0; }
  .release-highlights ul { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 32px; padding: 0; list-style: none; margin: 0; }
  .release-highlights strong { display: block; font-size: 1.125rem; font-weight: 600; line-height: 1.45; color: #d3e0ef; margin-bottom: 10px; }
  .release-highlights li span { display: block; font-size: 1.125rem; line-height: 1.7; color: var(--muted); }
  .download-grid { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 22px; }
  .download-card { border: 1px solid var(--line); background: #101826; border-radius: 9px; padding: 28px; display: flex; flex-direction: column; min-width: 0; }
  .download-card > svg { color: var(--cyan); margin-bottom: 17px; }
  .download-card .download-platform { font: .875rem/1.7 var(--mono); color: var(--dim); }
  .download-card h3 { font: 550 1.5rem/1.35 var(--display); letter-spacing: -.025em; margin: 10px 0 13px; }
  .download-card > p { font-size: 1.125rem; line-height: 1.7; color: var(--muted); margin: 0 0 20px; }
  .download-actions { display: flex; flex-direction: column; gap: 8px; margin: 10px 0 22px; }
  .download-actions .text-link { min-height: 44px; font-size: 1rem; line-height: 1.5; flex-wrap: wrap; }
  .file-size { color: var(--dim); font: .875rem/1.5 var(--mono); margin-left: auto; }
  .download-guide { padding-top: 18px; border-top: 1px solid var(--line); font-size: 1rem; line-height: 1.5; color: #bdcfe4; display: flex; align-items: center; gap: 8px; min-height: 44px; margin-top: auto; }
  .release-integrity { padding: 32px; border: 1px solid #5ae5ed20; border-radius: 10px; background: #0d1b25; display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 48px; }
  .release-integrity h2 { font: 500 23px var(--display); margin: 15px 0 12px; }
  .release-integrity > div > svg { color: var(--cyan); }
  .release-integrity p { font-size: 1.125rem; line-height: 1.75; color: var(--muted); max-width: 540px; margin: 0; }
  .integrity-links { display: flex; flex-direction: column; justify-content: center; gap: 8px; }
  .integrity-links a { display: flex; align-items: center; justify-content: space-between; gap: 12px; min-height: 44px; font-size: 1rem; line-height: 1.5; color: #b2dce6; padding-block: 8px 12px; border-bottom: 1px solid var(--line); }
  .release-next { display: grid; grid-template-columns: minmax(0,1.4fr) minmax(0,1fr); gap: 48px; align-items: center; }
  .release-next h2 { font-size: 32px; }
  .release-next p { font-size: 1.125rem; line-height: 1.75; color: var(--muted); max-width: 540px; margin: 18px 0 22px; }
  .release-next > div:last-child { display: flex; flex-direction: column; align-items: flex-start; gap: 18px; }
  .release-next .text-link { min-height: 44px; font-size: 1rem; line-height: 1.5; }

  @media (max-width: 1100px) {
    .download-grid { grid-template-columns: repeat(2,minmax(0,1fr)); }
    .release-highlights { grid-template-columns: 1fr; gap: 32px; }
  }
  @media (max-width: 760px) {
    .release-hero { padding-block: 40px; }
    .release-title { display: block; }
    .release-meta { text-align: left; margin: 0 0 25px; }
    .release-meta b { font-size: 26px; }
    .release-title h1 { font-size: 43px; }
    .release-meta span, .release-meta time { display: inline-block; margin-right: 14px; }
    .release-highlights { gap: 30px; padding-block: 30px; }
    .release-highlights ul { grid-template-columns: 1fr; gap: 24px; }
    .download-grid { grid-template-columns: 1fr; }
    .release-integrity { grid-template-columns: 1fr; padding: 25px; gap: 30px; }
    .release-next { grid-template-columns: 1fr; gap: 30px; }
    .release-hero .hero-ctas { flex-wrap: wrap; }
  }
  @media (max-width: 560px) {
    .download-card { padding: 24px; }
  }
</style>
